# Nebenkostenabrechnung, Konfiguration (NK-023, NK-076).
#
# Seit NK-076 ist diese Datei OPTIONAL: ohne .env startet die Anwendung mit
# Vorgaben, erzeugt ihren Sitzungsschluessel selbst im Datenordner und fuehrt
# im Browser durch die Einrichtung. Wer etwas aendern will:
#
#   cp .env.example .env    und nur die gewuenschten Zeilen setzen
#
# Hier steht nur, was die Anwendung bzw. docker-compose.yml wirklich liest.
# Die .env gehoert nie in ein Repository.

# --- Sitzungsschluessel (optional) ----------------------------------------------

# Leer lassen: die Anwendung erzeugt einen und legt ihn als secret_key in den
# Datenordner (NK-127). Wer ihn selbst setzt, braucht einen Zufallswert:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Beispielwerte oder weniger als 16 Zeichen lehnt der Start ab (NK-019).
SECRET_KEY=

# --- Nutzer im Container (NK-076) ---------------------------------------------

# Die Anwendung laeuft nicht als root, sondern als dieser Nutzer; ihm gehoert
# der Datenordner. Auf einer Synology den Nutzer des freigegebenen Ordners
# nehmen (id <name>).
PUID=1000
PGID=1000

# Welches Abbild compose startet (Etikett in ghcr.io/nerbry72/nebenkostenfix).
#NK_VERSION=latest

# --- Netz --------------------------------------------------------------------

# Auf welchem Port des Wirts die Oberflaeche erreichbar ist. Nur docker compose
# liest das, die Anwendung selbst bleibt im Container auf 6060. Leer lassen
# heisst 6060. Aendern, wenn der Port auf dem Wirt schon belegt ist.
APP_PORT=6060

# Auf 1 setzen, wenn ein HTTPS-Proxy davorhaengt. Dann bekommt das
# Sitzungscookie das Secure-Flag. Bei nacktem http:// aus lassen, sonst wirft
# der Browser das Cookie weg und niemand kommt mehr hinein.
BEHIND_HTTPS=

# Abmeldung nach so vielen Minuten ohne Anfrage (NK-128). Leer heisst 60.
SITZUNG_LEERLAUF_MIN=

# Hinter einem Reverse Proxy, der den Host umschreibt: die Adresse, unter der
# die Anwendung im Browser aufgerufen wird. Schreibende Anfragen von anderen
# Seiten lehnt die Anwendung ab (Schutz vor CSRF, NK-128). Mehrere mit Komma.
#ERLAUBTE_URSPRUENGE=https://nebenkosten.example.org
ERLAUBTE_URSPRUENGE=

# Nach jedem Fehlversuch bei der Anmeldung wartet die Antwort etwas laenger
# (Sekunden je Fehlversuch, hoechstens 2 s). Nach 5 Fehlversuchen fuer ein
# Konto oder 20 von einer Adresse ist die Anmeldung 15 Minuten gesperrt;
# `flask users passwd <name>` hebt die Sperre auf.
LOGIN_VERZOEGERUNG_S=

# --- Uploads -----------------------------------------------------------------

# Wie gross ein einzelner Beleg oder ein Mietvertrag hoechstens sein darf, in
# Megabyte. Gilt fuer den ganzen Anfragerumpf, also Datei plus Formularfelder.
# Leer lassen heisst 32. Ein gescannter PDF-Beleg liegt meist unter 10 MB, ein
# Handyfoto unter 5. Wer regelmaessig hochaufgeloest scannt, setzt hier mehr.
# Ueber dem Limit antwortet die Anwendung mit einem 413 und dem Satz
# "Der Upload ist zu gross. Erlaubt sind hoechstens <n> MB." Ein unlesbarer
# Wert wird ignoriert, dann gilt wieder 32.
MAX_UPLOAD_MB=32

# --- Protokoll ---------------------------------------------------------------

# Wie gespraechig die Anwendung in ihr Protokoll schreibt (NK-030). Erlaubt sind
# DEBUG, INFO, WARNING, ERROR, CRITICAL. Leer lassen heisst INFO. Das Protokoll
# geht nach stdout, zu lesen mit:
#   docker compose logs -f web
# Zu jedem unerwarteten Fehler steht dort eine Zeile mit derselben
# Vorgangsnummer, die der Nutzer auf dem Schirm sieht -- danach suchen:
#   docker compose logs web | grep A1B2C3D4
# Ein unlesbarer Wert wird ignoriert, dann gilt wieder INFO.
LOG_LEVEL=INFO

# Wohin das Protokoll zusaetzlich geschrieben wird (NK-042). Leer lassen heisst:
# neben die Datenbank, also data/nebenkosten.log -- dort ueberlebt es einen
# Neustart und auch einen neu gebauten Container. Genau das ist der Grund,
# warum eine Vorgangsnummer noch drei Tage spaeter etwas wert ist:
#   grep A1B2C3D4 data/nebenkosten.log
# Ein eigener Pfad verlegt die Datei. Wer sein Protokoll ohnehin ueber journald
# oder docker logs einsammelt und keine zweite Kopie auf der Platte will,
# schreibt hier ausdruecklich nichts hin und entfernt die Raute:
#LOG_DATEI=
LOG_DATEI=

# Ab welcher Groesse die Protokolldatei umgeschichtet wird und wie viele alte
# Staende daneben liegen bleiben. Voreinstellung: 5 Dateien zu je 5 MB, also
# hoechstens 30 MB. Ohne diese Grenze fuellt das Protokoll irgendwann die
# Platte -- und das trifft die Datenbank mit, die im selben Verzeichnis liegt.
# Unbrauchbare Werte, auch 0 und negative, fallen auf die Voreinstellung
# zurueck.
LOG_MAX_MB=5
LOG_ANZAHL=5

# --- Sicherungen --------------------------------------------------------------

# Verzeichnisse, in die die Oberflaeche Sicherungen schreiben und aus denen sie
# einspielen darf, zusaetzlich zum Datenordner (NK-149, F-76). Mehrere mit ':'
# trennen (unter Windows ';'). Alles andere lehnt die Anwendung ab -- auch ein
# Symlink, der aus einem freigegebenen Ordner herauszeigt. Ein NAS bindet man
# als Verzeichnis bzw. Volume ein und traegt es hier ein.
#BACKUP_ZIELE=/mnt/usb-sicherung:/mnt/nas-sicherung
BACKUP_ZIELE=

# Hoechstens so viele GB darf ein Umzugspaket oder eine Sicherung entpackt
# gross sein (NK-164). Schuetzt den Datenordner vor praeparierten Paketen.
# Leer heisst 50.
UMZUG_MAX_GB=

# --- Zahlungs-QR-Code auf der Abrechnung -------------------------------------

# Beide zusammen erzeugen bei einer Nachzahlung den EPC-QR-Code auf dem
# Deckblatt, den Bank-Apps einlesen. Fehlt eines von beiden, bleibt der Code
# weg und alles andere laeuft normal weiter.
VERMIETER_NAME=
VERMIETER_IBAN=

# --- Datenordner (NK-132) -----------------------------------------------------

# Ein Ordner fuer Datenbank, Belege, Sicherungen, Sitzungsschluessel und
# Protokoll. Docker setzt ihn in docker-compose.yml auf /data; die Windows-App
# auf Dokumente\Nebenkostenabrechnung. Ein NAS bindet man als diesen Ordner
# ein. Die frueheren Variablen NAS_MOUNT_PATH, NAS_HOST, NAS_SHARE,
# NAS_USERNAME und NAS_PASSWORD gibt es nicht mehr (NAS_MOUNT_PATH wirkt eine
# Version lang noch als Belegordner, wenn der Ordner existiert, und wird beim
# Start als veraltet gemeldet; zeigt er ins Leere, wird er ignoriert).
#DATA_DIR=/data

# --- Notausgang, im Normalbetrieb aus ----------------------------------------

# POST /api/debug/reset_db loescht die Datenbank und den Belege-Ordner.
# Solange ENABLE_DEBUG_RESET nicht gesetzt ist, antwortet die Route mit 404 und
# loescht nichts (NK-001). In einer Instanz mit echten Daten bleibt das aus.
# Seit NK-123 sieht die Oberfläche den Knopf der Gefahrenzone nur, wenn die
# Route in der laufenden Anwendung angemeldet ist (die Datei
# nebenkostenfix/debug_routen.py fehlt im Auslieferungsabbild, NK-040). Im
# Entwicklungsstapel genügt also das Freischalten hier; der Knopf fragt nach
# dem Geheimnis (NK-123).
# ENABLE_DEBUG_RESET=1
# DEBUG_RESET_SECRET=hier-ein-eigener-wert
# Aufruf braucht dann den Kopf: X-Debug-Secret: <derselbe Wert>
